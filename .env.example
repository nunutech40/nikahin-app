# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="postgresql://user:password@host:port/database"

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# ============================================
# APPLICATION SETTINGS
# ============================================
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ============================================
# PAYMENT GATEWAY - MAYAR.ID
# ============================================
# Get your API credentials from https://mayar.id/dashboard
MAYAR_API_KEY="your-mayar-api-key-here"
MAYAR_WEBHOOK_SECRET="your-mayar-webhook-secret-here"
NEXT_PUBLIC_MAYAR_MERCHANT_ID="your-merchant-id"

# ============================================
# EMAIL SERVICE (Optional - for notifications)
# ============================================
RESEND_API_KEY="your-resend-api-key-here"
RESEND_FROM_EMAIL="noreply@nikahin.app"

# ============================================
# ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
